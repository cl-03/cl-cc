  (is (= (cl-cc:main "s" "resume") 1))
  (is (= (cl-cc:main "s" "run") 1))
  (is (= (cl-cc:main "chat" "--unknown") 1))
  (is (= (cl-cc:main "session" "start" "--unknown") 1))
  (is (= (cl-cc:main "session" "start" "--output-format" "xml") 1))

;;;; tests/unit/command-dispatch-test.lisp - 命令注册与分发单元测试
(in-package :cl-cc/tests)

(def-suite command-dispatch-test :in cl-cc-suite)

(in-suite command-dispatch-test)

(test command-key-resolution
  (is (string= (cl-cc.core:command-key-from-argv '("--help")) "help"))
  (is (string= (cl-cc.core:command-key-from-argv '("chat")) "chat"))
  (is (string= (cl-cc.core:command-key-from-argv '("c")) "chat"))
  (is (string= (cl-cc.core:command-key-from-argv '("docs" "sync")) "docs sync-reference"))
  (is (string= (cl-cc.core:command-key-from-argv '("run" "--help")) "help"))
  (is (string= (cl-cc.core:command-key-from-argv '("-h")) "help"))
  (is (string= (cl-cc.core:command-key-from-argv '("session" "start")) "session start"))
  (is (string= (cl-cc.core:command-key-from-argv '("s" "start")) "session start"))
  (is (string= (cl-cc.core:command-key-from-argv '("session" "resume" "abc")) "session resume"))
  (is (string= (cl-cc.core:command-key-from-argv '("s" "resume" "abc")) "session resume"))
  (is (string= (cl-cc.core:command-key-from-argv '("session" "run" "abc")) "session run"))
  (is (string= (cl-cc.core:command-key-from-argv '("s" "run" "abc")) "session run"))
  (is (string= (cl-cc.core:command-key-from-argv '("run" "--fixture" "test")) "run --fixture"))
  (is (string= (cl-cc.core:command-key-from-argv '("r" "--fixture" "test")) "run --fixture")))

(test help-through-registry
  (cl-cc.core:ensure-default-commands)
  (let ((definition (cl-cc.core:find-command "help")))
    (is (typep definition 'cl-cc.models:command-definition))
    (is (string= (cl-cc.models:command-summary definition) "显示 CLI 帮助")))
  (let ((output (capture-output (lambda () (cl-cc:main "--help")))))
    (is (search "Usage:" output))
    (is (search "chat [<session-id-or-path>] [--session-path <session-path>] [--session-id <session-id>] [--tool <tool-id>]" output))
    (is (search "docs sync-reference [<output-path>] [--check] [--output-format <output-format>]" output))
    (is (search "run --fixture <fixture-id>... [--output-format <output-format>]" output))
    (is (search "session start [--session-id <session-id>] [--session-path <session-path>] [--history-index <history-index>]" output))
    (is (search "[default: text]" output))
    (is (search "[requires: --output-format=json]" output))))

(test docs-sync-reference-through-registry
  (let ((path (uiop:native-namestring
               (uiop:merge-pathnames* "generated-reference-test.md"
                                      (uiop:temporary-directory)))))
    (unwind-protect
         (progn
           (with-open-file (stream path :direction :output :if-exists :supersede :if-does-not-exist :create)
             (write-string (format nil "before~%<!-- BEGIN GENERATED COMMAND REFERENCE -->~%old~%<!-- END GENERATED COMMAND REFERENCE -->~%after~%")
                           stream))
           (let ((output (capture-output (lambda () (cl-cc:main "docs" "sync" path)))))
             (is (search "命令参考已同步" output)))
           (let ((contents (uiop:read-file-string path)))
             (is (search "### `docs sync-reference`" contents))
             (is (search "### `run --fixture`" contents))
             (is (search "before" contents))
             (is (search "after" contents))))
      (when (probe-file path)
        (delete-file path)))))

(test docs-sync-reference-check-mode
  (let ((path (uiop:native-namestring
               (uiop:merge-pathnames* "generated-reference-check-test.md"
                                      (uiop:temporary-directory)))))
    (unwind-protect
         (progn
           (with-open-file (stream path :direction :output :if-exists :supersede :if-does-not-exist :create)
             (write-string (format nil "before~%<!-- BEGIN GENERATED COMMAND REFERENCE -->~%old~%<!-- END GENERATED COMMAND REFERENCE -->~%after~%")
                           stream))
           (let ((before-check (uiop:read-file-string path)))
             (is (= (cl-cc:main "docs" "sync" path "--check") 1))
             (is (string= before-check (uiop:read-file-string path))))
           (let ((json-output (capture-output (lambda () (cl-cc:main "docs" "sync" path "--check" "--output-format" "json")))))
             (is (search "\"status\":\"drift\"" json-output))
             (is (search "\"checkOnly\":true" json-output))
             (is (search "\"updated\":false" json-output))
             (is (search "\"needsSync\":true" json-output))
             (is (search "\"durationSeconds\":" json-output))
             (is (search "\"exitCode\":1" json-output)))
           (is (= (cl-cc:main "docs" "sync" path) 0))
           (let ((output (capture-output (lambda () (cl-cc:main "docs" "sync" path "--check")))))
             (is (search "命令参考已是最新" output))
             (is (not (search "需要同步" output))))
           (let ((json-output (capture-output (lambda () (cl-cc:main "docs" "sync" path "--check" "-o" "json")))))
             (is (search "\"status\":\"in-sync\"" json-output))
             (is (search "\"checkOnly\":true" json-output))
             (is (search "\"updated\":false" json-output))
             (is (search "\"needsSync\":false" json-output))
             (is (search "\"durationSeconds\":" json-output))
             (is (search "\"exitCode\":0" json-output))))
      (when (probe-file path)
        (delete-file path)))))

